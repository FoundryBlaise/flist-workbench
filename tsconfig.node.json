{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    // The main process renders profile previews to PNG and calls the
    // renderer's BBCode converter to do it — one implementation, so a
    // model's picture and the user's preview cannot disagree. Pure
    // string functions, no DOM.
    "renderer/src/lib/bbcode/index.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
